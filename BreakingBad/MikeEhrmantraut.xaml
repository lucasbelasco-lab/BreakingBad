<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BreakingBad.MikeEhrmantraut"
             Title="Mike Ehrmantraut"
             BackgroundColor="#F2F2F2">

	<ScrollView>

		<VerticalStackLayout Padding="25,20"
                             Spacing="18">

			<Label Text="MIKE EHRMANTRAUT"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#4F6F16" />

			<BoxView HeightRequest="3"
                     BackgroundColor="#6B8E23"
                     WidthRequest="80"
                     HorizontalOptions="Center" />

			<Border Stroke="#CCCCCC"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="8"
                    StrokeShape="RoundRectangle 10">

				<Image Source="mike.jpg"
                       HeightRequest="230"
                       Aspect="AspectFit" />

			</Border>

			<Border BackgroundColor="White"
                    Stroke="#6B8E23"
                    StrokeThickness="1"
                    Padding="20"
                    StrokeShape="RoundRectangle 10">

				<VerticalStackLayout Spacing="12">

					<Label Text="Sobre o personagem"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#4F6F16" />

					<Label Text="Mike Ehrmantraut é um dos personagens mais experientes de Breaking Bad. Ele é conhecido por ser reservado, cuidadoso e habilidoso em situações perigosas."
                           FontSize="16"
                           TextColor="#444444" />

					<Label Text="Antes dos acontecimentos principais da série, Mike trabalhou como policial. Essa experiência contribuiu para seus conhecimentos sobre segurança e investigação."
                           FontSize="16"
                           TextColor="#444444" />

					<Label Text="Ao longo da história, Mike passa a trabalhar para pessoas envolvidas com o mundo do crime, sendo responsável por proteger pessoas e resolver problemas."
                           FontSize="16"
                           TextColor="#444444" />

					<Label Text="Mike também tem contato com Walter White e outros personagens importantes. Sua calma e experiência são algumas de suas principais características."
                           FontSize="16"
                           TextColor="#444444" />

				</VerticalStackLayout>

			</Border>

		</VerticalStackLayout>

	</ScrollView>

</ContentPage>