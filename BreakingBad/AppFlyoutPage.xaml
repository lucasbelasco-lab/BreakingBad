<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BreakingBad.AppFlyoutPage"
             FlyoutLayoutBehavior="Popover">
    <FlyoutPage.Flyout>
        <ContentPage Title="Menu" BackgroundColor="Black">
            <ScrollView>
                <VerticalStackLayout
                    Padding="15,40,15,15"
                    Spacing="12"
                    <Label
                        Text="BREAKING BAD"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Margin="0,0,0,20"
                        />
                    <Button 
                        Text="Walter White"
                        Clicked="OnWalterClicked"/>
                    <Button 
    Text="Jesse Pinkman"
    Clicked="OnJesseClicked"/>
                    <Button 
    Text="Saul Goodman"
    Clicked="OnSaulClicked"/>
                    <Button 
    Text="Mike Ehrmantraut"
    Clicked="OnMikeClicked"/>
                </VerticalStackLayout>
            </ScrollView>
        </ContentPage>
    </FlyoutPage.Flyout>
</FlyoutPage>